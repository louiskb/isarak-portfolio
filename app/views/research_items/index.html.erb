<% content_for :title, "Research — Isara Khanjanasthiti" %>

<%# ===== HERO ===== %>
<section class="resource-hero">
  <div class="container">
    <div class="resource-hero-inner">
      <p class="resource-hero-label">Research</p>
      <h1 class="resource-hero-title">Research & Publications</h1>
      <p class="resource-hero-subtitle">
        Urban planning, aviation policy, housing governance, and university teaching & learning.
      </p>
      <% if user_signed_in? %>
        <p class="resource-hero-subtitle resource-hero-info mt-2">
          <i class="fa-solid fa-star me-1" style="color: #facc15;"></i>Tick <strong>`Featured`</strong> on an item to include it in the homepage Research section — <span class="hi-teal">max 4 shown, most recently updated first</span>. If you feature more than 4, the most recently edited items take priority. <span class="hi-grad">Drag to reorder</span> — the order you set here is exactly what visitors see on this Research page (the homepage Featured section is separate). Items default to newest publication first — use <strong>View all on one page</strong> to drag across everything without pages, or <strong>Sort by most recent</strong> to reset.
        </p>
        <div class="mt-4 d-flex flex-wrap gap-2">
          <%= link_to new_research_item_path, class: "btn btn-grad" do %>
            <i class="fa-solid fa-plus me-1"></i>Add Research Item
          <% end %>
          <% if @full_view %>
            <%= link_to research_items_path, class: "btn home-btn-outline" do %>
              <i class="fa-solid fa-compress me-1"></i>Back to paged view
            <% end %>
            <%= link_to sort_by_recency_research_items_path, class: "btn home-btn-outline",
                  data: { turbo_method: :patch,
                          turbo_confirm: "This resets the order to newest-first and discards your manual arrangement. Continue?" } do %>
              <i class="fa-solid fa-arrow-down-wide-short me-1"></i>Sort by most recent
            <% end %>
          <% else %>
            <%= link_to research_items_path(view: "full"), class: "btn home-btn-outline" do %>
              <i class="fa-solid fa-up-right-and-down-left-from-center me-1"></i>View all on one page
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# ===== GRID ===== %>
<section class="resource-grid-section">
  <div class="container">
    <% if @research_items.any? %>
      <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4"
           <% if user_signed_in? %>data-controller="sortable" data-sortable-url-value="<%= reorder_research_items_path %>"<% end %>>
        <% @research_items.each do |item| %>
          <div class="col" data-id="<%= item.id %>">
            <article class="resource-card card">
              <% if user_signed_in? %>
                <div class="drag-handle" title="Drag to reorder">
                  <i class="fa-solid fa-grip-vertical"></i>
                </div>
              <% end %>
              <% img_src = item.image.attached? ? (url_for(item.image) rescue nil) : item.image_url.presence %>
              <% if img_src %>
                <img src="<%= img_src %>" class="resource-card-img" alt="<%= item.title %>">
              <% end %>
              <div class="card-body">
                <%# Category badge %>
                <span class="resource-card-category resource-badge-<%= item.category %>">
                  <%= ResearchItem::CATEGORY_LABELS[item.category] %>
                </span>

                <%# Status badge (Isara only) %>
                <% if user_signed_in? %>
                  <div class="mb-2">
                    <span class="badge rounded-pill blog-status-<%= item.status %>">
                      <%= item.status.capitalize %>
                    </span>
                  </div>
                <% end %>

                <h2 class="resource-card-title">
                  <%= link_to item.title, research_item_path(item), class: "resource-card-title-link" %>
                </h2>

                <% if item.authors.present? %>
                  <p class="resource-card-meta mb-1">
                    <i class="fa-solid fa-user-pen me-1"></i>
                    <%= item.authors %>
                  </p>
                <% end %>

                <% if item.published_at.present? || (user_signed_in? && item.scheduled? && item.scheduled_at) %>
                  <p class="resource-card-meta">
                    <% if item.published_at.present? %>
                      <i class="fa-regular fa-calendar me-1"></i>
                      <%= item.published_at.strftime("%B %Y") %>
                    <% end %>
                    <% if user_signed_in? && item.scheduled? && item.scheduled_at %>
                      &nbsp;· <i class="fa-regular fa-clock me-1"></i>Scheduled <%= item.scheduled_at.strftime("%-d %b %Y at %H:%M") %>
                    <% end %>
                    <% if item.featured? %>&nbsp;<i class="fa-solid fa-star ms-1" title="Featured"></i><% end %>
                  </p>
                <% end %>

                <% if item.card_summary.present? %>
                  <p class="resource-card-description"><%= item.card_summary %></p>
                <% end %>

                <div class="resource-card-footer">
                  <%= link_to "View →", research_item_path(item), class: "btn btn-resource-link btn-sm" %>
                  <% if user_signed_in? %>
                    <%= link_to "Manage →", research_item_path(item), class: "btn btn-resource-manage btn-sm ms-auto" %>
                  <% end %>
                </div>
              </div>
            </article>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="resource-empty text-center">
        <p class="text-muted mb-3">No research items yet.</p>
        <% if user_signed_in? %>
          <%= link_to "Add your first item", new_research_item_path, class: "btn btn-resource-add" %>
        <% end %>
      </div>
    <% end %>

    <% if @pagy && @pagy.pages > 1 %>
      <div class="mt-5">
        <%= raw @pagy.series_nav(:bootstrap) %>
      </div>
    <% end %>
  </div>
</section>
